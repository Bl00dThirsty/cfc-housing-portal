# ===========================================================================
# CFC Housing Portal — variables d'environnement
#
# Copiez ce fichier en `.env.local` et renseignez les valeurs.
#
# Projet Supabase CFC (Crédit Foncier du Cameroun) :
#   project ref : yyqfqsmsfaccsstwlpog
#   URL locale  : http://127.0.0.1:54321
#   prod        : https://cfc-housing-portal-sooty.vercel.app/
#
# Les variables NEXT_PUBLIC_* sont INLINÉES AU BUILD : une modification exige
# un redémarrage de `next dev` ou un nouveau `next build`.
#
# Démarrage local le plus simple : `supabase start`, puis reportez les valeurs
# affichées par `supabase status -o env`.
# ===========================================================================

# ---------------------------------------------------------------------------
# Supabase — variables publiques (exposées au navigateur, anon key uniquement)
# ---------------------------------------------------------------------------

# URL du projet Supabase. Exemple : https://yyqfqsmsfaccsstwlpog.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé anonyme (anon / publishable). Elle respecte les politiques RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase — variables serveur
# ---------------------------------------------------------------------------

# Clé de service (service_role). Elle CONTOURNE les politiques RLS :
#   - usage serveur uniquement (actions serveur, Edge Functions, traitements
#     de fond) ;
#   - ne JAMAIS préfixer par NEXT_PUBLIC_ ;
#   - ne JAMAIS l'exposer au client ni la committer.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# URL publique du site. Sert aux redirections de callback (lien de
# réinitialisation de mot de passe, lien magique).
# Local : http://localhost:3000 — Production : URL HTTPS canonique.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Messagerie métier — toutes optionnelles
# ---------------------------------------------------------------------------
#
# Sans configuration, le service d'e-mail journalise chaque envoi en
# `skipped` et l'opération métier continue. Resend est prioritaire sur SMTP.

# Resend (https://resend.com) — fournisseur recommandé.
RESEND_API_KEY=

# Adresse d'expédition autorisée. Le domaine doit être vérifié (SPF/DKIM).
EMAIL_FROM="Crédit Foncier du Cameroun <no-reply@cfchousing.cm>"

# Relais SMTP explicite (utilisé seulement si RESEND_API_KEY est vide).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# `false` uniquement pour un relais de recette doté d'une autorité interne.
SMTP_TLS_REJECT_UNAUTHORIZED=true

# ---------------------------------------------------------------------------
# Scripts de développement et de test — locaux seulement
# ---------------------------------------------------------------------------

# Mot de passe des comptes de démonstration créés par `npm run db:seed:users`.
CFC_DEV_PASSWORD=CfcDev2026!

# Identifiant envoyé à Nominatim (OpenStreetMap) pour la recherche d'adresse.
NOMINATIM_USER_AGENT=cfc-housing-portal/1.0 (contact@cfchousing.cm)

# ---------------------------------------------------------------------------
# Version affichée dans l'interface
# ---------------------------------------------------------------------------
#
# NE PAS RENSEIGNER : `next.config.ts` la déduit de `package.json`
# (`NEXT_PUBLIC_APP_VERSION`). Une valeur saisie ici masquerait la vraie
# version livrée.
