# ===========================================================================
# CFC Housing Portal — variables d'environnement
#
# Copiez ce fichier en `.env.local` et renseignez les valeurs.
#
# Projet Supabase CFC (Crédit Foncier du Cameroun) :
#   project ref : yyqfqsmsfaccsstwlpog
#   URL locale  : http://127.0.0.1:54321
#   prod: https://cfc-housing-portal-sooty.vercel.app/
#
# Les variables NEXT_PUBLIC_* sont INLINÉES AU BUILD : une modification exige
# un redémarrage de `next dev` ou un nouveau `next build`.
# ===========================================================================

# ---------------------------------------------------------------------------
# Supabase — variables publiques (exposées au navigateur, anon key uniquement)
# ---------------------------------------------------------------------------

# URL du projet Supabase. Example : https://yyqfqsmsfaccsstwlpog.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé anonyme (anon / publishable). Elle respecte les politiques RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase — variables serveur
# ---------------------------------------------------------------------------

# Clé de service (service_role). Elle CONTOURNE les politiques RLS :
#   - usage serveur uniquement (actions serveur, Edge Functions, traitements
#     de fond) ;
#   - ne JAMAIS préfixer par NEXT_PUBLIC_ ;
#   - ne JAMAIS l'exposer au client ni la committer.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# URL publique du site. Sert aux redirections de callback (lien de
# réinitialisation de mot de passe, lien magique).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
